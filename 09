local aimConn
Tabs.Combat:AddToggle("SilentAimbot", {
    Title = "🎯 Silent Aimbot (ล็อคหัวคนใกล้)",
    Default = false,
    Callback = function(v)
        if v then
            aimConn = RunService.RenderStepped:Connect(function()
                local nearest, dist = nil, math.huge
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LP and p.Character and p.Character:FindFirstChild("Head") then
                        local d = (p.Character.Head.Position - LP.Character.Head.Position).Magnitude
                        if d < dist then dist = d; nearest = p end
                    end
                end
                if nearest then
                    workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position, nearest.Character.Head.Position)
                end
            end)
        else
            if aimConn then aimConn:Disconnect() end
        end
    end
})

