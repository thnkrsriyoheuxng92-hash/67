-- 7. ESP System
local function ApplyESP(p)
    if p ~= LocalPlayer and p.Character then
        if Settings.ESP and not p.Character:FindFirstChild("PhuPha_ESP") then
            local hl = Instance.new("Highlight")
            hl.Name = "PhuPha_ESP"
            hl.FillColor = Color3.fromRGB(255, 0, 50)
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.FillTransparency = 0.4
            hl.Parent = p.Character
        end
        if (Settings.NameESP or Settings.DistanceESP or Settings.HealthESP) and p.Character:FindFirstChild("Head") and not p.Character.Head:FindFirstChild("PhuPha_Info") then
            local bb = Instance.new("BillboardGui")
            bb.Name = "PhuPha_Info"
            bb.Adornee = p.Character.Head
            bb.Size = UDim2.new(0, 150, 0, 40)
            bb.StudsOffset = Vector3.new(0, 2.5, 0)
            bb.AlwaysOnTop = true
            
            local txt = Instance.new("TextLabel")
            txt.Name = "InfoLabel"
            txt.Parent = bb
            txt.Size = UDim2.new(1, 0, 1, 0)
            txt.BackgroundTransparency = 1
            txt.TextColor3 = Color3.fromRGB(255, 255, 0)
            txt.TextScaled = true
            txt.Font = Enum.Font.SourceSansBold
            bb.Parent = p.Character.Head
        end
    end
end

RunService.RenderStepped:Connect(function()
    if Settings.NameESP or Settings.DistanceESP or Settings.HealthESP then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character.Head:FindFirstChild("PhuPha_Info") then
                local lbl = p.Character.Head.PhuPha_Info:FindFirstChild("InfoLabel")
                if lbl then
                    local str = ""
                    if Settings.NameESP then str = str .. p.Name .. "\n" end
                    if Settings.HealthESP and p.Character:FindFirstChildOfClass("Humanoid") then
                        str = str .. "HP: " .. math.floor(p.Character:FindFirstChildOfClass("Humanoid").Health) .. " "
                    end
                    if Settings.DistanceESP and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local dist = math.floor((p.Character.Head.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude)
                        str = str .. "[" .. dist .. "m]"
                    end
                    lbl.Text = str
                end
            end
        end
    end
end)

local function RemoveESP(p)
    if p.Character then
        if p.Character:FindFirstChild("PhuPha_ESP") then p.Character.PhuPha_ESP:Destroy() end
        if p.Character:FindFirstChild("Head") and p.Character.Head:FindFirstChild("PhuPha_Info") then p.Character.Head.PhuPha_Info:Destroy() end
    end
end

