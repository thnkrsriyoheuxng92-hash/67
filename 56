-- 37. FPS Booster
Tabs.AntiLag:AddToggle("T37", { 
    Title = "37. 🚀 เปิดโหมด FPS Booster (ลดกระตุก)", 
    Default = false, 
    Callback = function(v) 
        Settings.FPSBoost = v
        if v then
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") then
                    if not OriginalMaterials[obj] then
                        OriginalMaterials[obj] = obj.Material
                    end
                    obj.Material = Enum.Material.SmoothPlastic
                end
            end
        else
            settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
            for obj, mat in pairs(OriginalMaterials) do
                if obj and obj.Parent then
                    obj.Material = mat
                end
            end
        end
    end 
})

-- 38. Remove Particles
Tabs.AntiLag:AddToggle("T38", { 
    Title = "38. 🗑️ ลบเอฟเฟกต์/ควันทั้งหมด (Remove Particles)", 
    Default = false, 
    Callback = function(v) 
        Settings.RemoveParticles = v
        if v then
            for _, p in pairs(Workspace:GetDescendants()) do
                if p:IsA("ParticleEmitter") or p:IsA("Smoke") or p:IsA("Fire") or p:IsA("Sparkles") then
                    if p.Enabled then
                        SavedParticles[p] = true
                        p.Enabled = false
                    end
                end
            end
        else
            for p, _ in pairs(SavedParticles) do
                if p and p.Parent then
                    p.Enabled = true
                end
            end
            SavedParticles = {}
        end
    end 
})

-- 39. Low Textures
Tabs.AntiLag:AddToggle("T39", { 
    Title = "39. 🧱 โหมดแมพดินน้ำมัน (Low Textures)", 
    Default = false, 
    Callback = function(v) 
        Settings.LowTextures = v
        if v then
            for _, t in pairs(Workspace:GetDescendants()) do
                if t:IsA("Decal") or t:IsA("Texture") then
                    if not OriginalTextures[t] then
                        OriginalTextures[t] = t.Transparency
                    end
                    t.Transparency = 1
                end
            end
        else
            for t, trans in pairs(OriginalTextures) do
                if t and t.Parent then
                    t.Transparency = trans
                end
            end
        end
    end 
})

